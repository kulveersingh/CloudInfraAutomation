[
  {"project_name": "orders-api",
   "ownership": {"portfolio_id": "pf-payments", "product_id": "pr-invoicing", "data_classification": "confidential"},
   "resilience": {"mode": "single", "primary_region": "us-east-1"},
   "environments": ["sandbox", "dev", "test", "stage", "prod"],
   "resources": [{"id": "uploads", "type": "s3.bucket"}, {"id": "processor", "type": "lambda.function"},
                 {"id": "orders", "type": "dynamodb.table"}, {"id": "events", "type": "sqs.queue"}],
   "connections": [{"kind": "event.notify", "source": "uploads", "target": "processor", "prefix": "incoming/"},
                   {"kind": "iam.access", "source": "processor", "target": "orders", "access": "readwrite"},
                   {"kind": "iam.access", "source": "processor", "target": "events", "access": "write"}]},
  {"project_name": "invoice-dr",
   "ownership": {"portfolio_id": "pf-payments", "product_id": "pr-invoicing", "data_classification": "confidential"},
   "resilience": {"mode": "dr", "primary_region": "us-east-1", "secondary_region": "us-east-2"},
   "environments": ["dev", "test", "stage", "prod"],
   "resources": [{"id": "archive", "type": "s3.bucket"}, {"id": "indexer", "type": "lambda.function"},
                 {"id": "invoices", "type": "dynamodb.table"}],
   "connections": [{"kind": "event.notify", "source": "archive", "target": "indexer"},
                   {"kind": "iam.access", "source": "indexer", "target": "invoices", "access": "readwrite"}]},
  {"project_name": "catalog-ha",
   "ownership": {"portfolio_id": "pf-payments", "product_id": "pr-invoicing", "data_classification": "internal"},
   "resilience": {"mode": "ha", "primary_region": "us-east-1", "secondary_region": "us-east-2"},
   "environments": ["dev", "test", "stage", "prod"],
   "resources": [{"id": "reader", "type": "lambda.function"}, {"id": "items", "type": "dynamodb.table"}],
   "connections": [{"kind": "iam.access", "source": "reader", "target": "items", "access": "read"}]},
  {"project_name": "no-vpc-batch",
   "ownership": {"portfolio_id": "pf-payments", "product_id": "pr-invoicing", "data_classification": "internal"},
   "environments": ["dev", "prod", "stage"],
   "resources": [{"id": "jobs", "type": "sqs.queue"}, {"id": "worker", "type": "lambda.function"}],
   "connections": [{"kind": "iam.access", "source": "worker", "target": "jobs", "access": "read"}],
   "network": {"attach_compute": false}},
  {"project_name": "data-services",
   "ownership": {"portfolio_id": "pf-payments", "product_id": "pr-invoicing", "data_classification": "confidential"},
   "environments": ["dev", "test", "stage", "prod"],
   "resources": [
     {"id": "alerts", "type": "AWS::SNS::Topic", "config": {"properties": {"DisplayName": "Alerts"}}},
     {"id": "applogs", "type": "AWS::Logs::LogGroup", "config": {"properties": {"RetentionInDays": 90}}},
     {"id": "images", "type": "AWS::ECR::Repository", "config": {"properties": {"ImageScanningConfiguration": {"ScanOnPush": true}}}},
     {"id": "ledger", "type": "AWS::RDS::DBCluster", "config": {"properties": {
        "Engine": "aurora-postgresql", "MasterUsername": "ledgeradmin", "ManageMasterUserPassword": true,
        "StorageEncrypted": true, "ServerlessV2ScalingConfiguration": {"MinCapacity": 0.5, "MaxCapacity": 4}}}},
     {"id": "flag", "type": "AWS::SSM::Parameter", "config": {"properties": {"Type": "String", "Value": "on"}}}
   ]}
]
