{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TeardownVaultsIncludingDeletesAndTheGovernanceBypass",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectRetention",
                 "s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketObjectLockConfiguration", "s3:DeleteObject",
                 "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention"],
      "Resource": ["arn:aws:s3:::teardown-*", "arn:aws:s3:::teardown-*/*"]
    },
    {
      "Sid": "ControlBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::cloudinfra-vault", "arn:aws:s3:::cloudinfra-vault/*"]
    }
  ]
}
